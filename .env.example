# -------------------------
# Hindsight
# -------------------------
HINDSIGHT_VERSION=latest

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_EMBEDDING_MODEL=perplexity/pplx-embed-v1-0.6b
OPENROUTER_RERANKER_MODEL=cohere/rerank-v3.5

# -------------------------
# Shared PostgreSQL instance
# -------------------------
POSTGRES_USER=hindsight
POSTGRES_PASSWORD=replace-me-with-a-long-random-password
POSTGRES_DB=hindsight

# -------------------------
# LiteLLM
# -------------------------
LITELLM_VERSION=latest
LITELLM_MASTER_KEY=sk-replace-me-with-a-long-random-key
# Keep this value stable after the first deployment.
LITELLM_SALT_KEY=sk-replace-me-with-a-long-random-key
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=replace-me-with-a-long-random-password
LITELLM_DB_NAME=litellm

# -------------------------
# Hindsight authentication
# -------------------------
# Bearer token for the Hindsight REST API.
HINDSIGHT_API_KEY=replace-me-with-a-long-random-key
# Token used specifically by Hindsight MCP clients.
HINDSIGHT_MCP_TOKEN=replace-me-with-a-long-random-token
# Login/access key for the Hindsight Control Plane UI.
HINDSIGHT_UI_ACCESS_KEY=replace-me-with-a-long-random-key
